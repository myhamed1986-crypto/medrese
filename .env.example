# Copy to .env and fill values to enable email notifications
# SMTP settings (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=from@example.com
# Email address to receive notifications
NOTIFY_EMAIL=you@example.com

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Optional Twilio WhatsApp (you need a Twilio account and WhatsApp-enabled Twilio sender)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio WhatsApp 'from' phone (without whatsapp: prefix) e.g. +1415xxxxxxx
TWILIO_WHATSAPP_FROM=+1415XXXXXXX
# Your destination WhatsApp number (international format) e.g. +996556XXXXXX
WHATSAPP_TO=+996555123456
